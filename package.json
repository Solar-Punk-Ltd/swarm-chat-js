{
  "name": "@solarpunkltd/swarm-chat-js",
  "version": "7.0.0",
  "description": "JS library for chatting on Swarm",
  "keywords": [
    "chat",
    "js",
    "swarm"
  ],
  "bugs": {
    "url": "https://github.com/Solar-Punk-Ltd/swarm-chat-js/issues"
  },
  "license": "Apache-2.0",
  "author": "levente.kiss@solarpunk.buzz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solar-Punk-Ltd/swarm-chat-js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./message": {
      "types": "./dist/message/index.d.ts",
      "import": "./dist/message.js",
      "require": "./dist/message.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "@types/node": "24.13.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@ethersphere/bee-js": "^13.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
